# Copia este archivo como .env y ajusta los valores.
# El .env real nunca se sube al repositorio (está en .gitignore).

# ---------------------------------------------------------------------
# Entorno: desarrollo | produccion
# En "produccion" la API se niega a arrancar si quedan valores de ejemplo,
# y oculta las páginas /docs y /redoc.
# ---------------------------------------------------------------------
ENTORNO=desarrollo

# ---------------------------------------------------------------------
# Base de datos
# Local: MySQL o MariaDB en la propia máquina
# AWS:   endpoint de la instancia RDS
# ---------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://root:tu_password@localhost:3306/composta_db

# ---------------------------------------------------------------------
# Autenticación
# Genera el secreto con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------
JWT_SECRET=dev-secret-cambiar
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---------------------------------------------------------------------
# Orígenes permitidos por CORS (separados por coma)
# Local: el servidor de desarrollo de Vite
# AWS:   el dominio de CloudFront, p. ej. https://d1234abcd.cloudfront.net
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Prefijo de las rutas de la API
# Local: vacío   -> /lotes, /auth/login ...
# AWS:   /api    -> /api/lotes ...  (CloudFront enruta /api/* a la EC2)
# ---------------------------------------------------------------------
API_PREFIX=

# ---------------------------------------------------------------------
# Modelo entrenado
# ---------------------------------------------------------------------
ML_MODEL_PATH=../ml/modelos/modelo_composta.joblib

# ---------------------------------------------------------------------
# Usuario administrador (solo lo lee scripts/crear_admin.py)
# Si no defines ADMIN_PASSWORD, el script genera una y la muestra una vez.
# ---------------------------------------------------------------------
# ADMIN_EMAIL=kevin@composterra.mx
# ADMIN_PASSWORD=
